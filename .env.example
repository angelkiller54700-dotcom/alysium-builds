# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Discord webhook the contact form posts to.
# Create one in Discord: Server Settings → Integrations → Webhooks → New Webhook
# → pick the channel you want submissions to land in → Copy Webhook URL.
DISCORD_WEBHOOK_URL=

# GitHub OAuth App, used only so the CMS at /admin can authenticate you when
# editing from anywhere (not just your own machine). Create one at
# https://github.com/settings/developers → OAuth Apps → New OAuth App
#   Homepage URL: https://alysium-builds.vercel.app
#   Authorization callback URL: https://alysium-builds.vercel.app/callback
# Only needed on Vercel (production) — local editing via `npm run cms`
# doesn't use this at all.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
